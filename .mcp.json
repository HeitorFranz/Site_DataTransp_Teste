{
  "mcpServers": {
    "shadcn": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@jpisnice/shadcn-ui-mcp-server", "--github-api-key", "${GITHUB_TOKEN_SHADCN}"]
    },
    "magic": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@21st-dev/magic@latest"],
      "env": { "API_KEY": "${MAGIC_API_KEY}" }
    }
  }
}
