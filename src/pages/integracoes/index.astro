---
import Layout from '../../layouts/SiteLayout.astro';
import Icon, { type IconName } from '../../components/home/Icon.astro';
import IntegracaoIlustracao from '../../components/modulos/IntegracaoIlustracao.astro';
import { integrations, modules } from '../../data/empresa';
import { integracoesDetalhes } from '../../data/integracoes-detalhes';
import '../../styles/modulo.css';
import PageFoto from '../../components/PageFoto.astro';

// integrações agrupadas pelo módulo do mesmo assunto
const grupos = modules
  .filter((m) => m.confirmed)
  .map((m) => ({ modulo: m, itens: integrations.filter((i) => integracoesDetalhes[i.slug]?.modulo === m.slug) }))
  .filter((g) => g.itens.length > 0);
---

<Layout title="Integrações | Datatransp" description="Integrações do DataTransp com bancos, contabilidade, SPED, EDI, seguradoras, CIOT e abastecimentos." currentPath="/integracoes" bodyClass="page-modulo">
  <section class="md-hero">
    <div class="container md-hero__grid">
      <div>
        <div class="breadcrumbs"><a href="/">Início</a> / <span>Integrações</span></div>
        <h1>Integrações</h1>
        <p class="md-lead">O DataTransp conversa com bancos, contabilidade, clientes, seguradoras e órgãos do transporte. Veja o que cada integração faz e fale com a equipe para confirmar o escopo na sua operação.</p>
        <div class="md-actions">
          <a class="btn btn-primary" href="/contato#agendar-demonstracao">Falar com a equipe</a>
        </div>
      </div>
      <IntegracaoIlustracao title="Integrações" parceiro="Bancos, contabilidade e parceiros" />
    </div>
  </section>

  <PageFoto revelar="circulo" foto="bau-rodovia" alt="Traseira de um caminhão baú em rodovia movimentada" autor="Juliana Polizel" link="https://www.pexels.com/pt-br/foto/caminhao-branco-na-estrada-5668906/" titulo="A carga anda. A informação também.">
    <p>O DataTransp conversa com bancos, contabilidade, embarcadores e seguradoras. Menos digitação, menos erro e menos arquivo indo e voltando por e-mail.</p>
    <p>Veja abaixo cada integração, o que ela faz e com qual módulo se conecta.</p>
  </PageFoto>

  {grupos.map((g, idx) => (
    <section class:list={['md-section', { 'md-section--soft': idx % 2 === 0 }]}>
      <div class="container">
        <div class="md-others__head">
          <h2><span class="md-inline-icon"><Icon name={g.modulo.slug as IconName} size={22} /></span>{g.modulo.title}</h2>
          <a href={`/funcionalidades/${g.modulo.slug}`}>Ver o módulo {g.modulo.title}</a>
        </div>
        <ul class="md-integ">
          {g.itens.map((i) => (
            <li>
              <a href={`/integracoes/${i.slug}`}>
                <strong>{i.title}</strong>
                <span>{integracoesDetalhes[i.slug].oQueE}</span>
                <em>Entender esta integração</em>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Layout>
