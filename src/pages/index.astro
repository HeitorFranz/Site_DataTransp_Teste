---
import Layout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import JoinSection from '../components/home/JoinSection.astro';
import ClientsSection from '../components/home/ClientsSection.astro';
import CareSection from '../components/home/CareSection.astro';
import SolutionsSection from '../components/home/SolutionsSection.astro';
import FlowSection from '../components/home/FlowSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import '../styles/home.css';
---

<Layout currentPath="/" bodyClass="page-home">
  <HomeHero />
  <JoinSection />
  <ClientsSection />
  <CareSection />
  <FlowSection />
  <SolutionsSection />
  <FaqSection />
</Layout>

<script>
  import { initHomeMotion } from '../scripts/home-motion';
  initHomeMotion();
</script>
