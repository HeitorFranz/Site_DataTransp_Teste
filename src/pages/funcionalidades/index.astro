---
import Layout from '../../layouts/SiteLayout.astro';
import Icon, { type IconName } from '../../components/home/Icon.astro';
import ModuloIlustracao from '../../components/modulos/ModuloIlustracao.astro';
import FolhetoGTF from '../../components/modulos/FolhetoGTF.astro';
import { modules } from '../../data/empresa';
import { explicacoes } from '../../data/modulos-detalhes';
import '../../styles/modulo.css';
import PageFoto from '../../components/PageFoto.astro';

const confirmedModules = modules.filter((module) => module.confirmed);
---

<Layout title="Funcionalidades | Datatransp" description="Conheça os módulos do DataTransp: fiscal, financeiro, manutenção, pneus, combustíveis e Arla, alertas e BI." currentPath="/funcionalidades" bodyClass="page-modulo">
  <nav class="md-switch md-switch--spy" aria-label="Módulos do DataTransp">
    <div class="container md-switch__inner">
      {confirmedModules.map((m) => (
        <a href={`#${m.slug}`}><Icon name={m.slug as IconName} size={17} />{m.title}</a>
      ))}
      <span class="md-switch__ink" aria-hidden="true"></span>
    </div>
  </nav>

  <section class="md-hero">
    <div class="container md-hero__grid">
      <div>
        <div class="breadcrumbs"><a href="/">Início</a> / <span>Funcionalidades</span></div>
        <h1>Funcionalidades</h1>
        <p class="md-lead">Os módulos do DataTransp cobrem a rotina da transportadora: documentos fiscais, financeiro, frota e indicadores. Veja o que cada um faz, em poucas palavras.</p>
        <div class="md-actions">
          <a class="btn btn-primary" href="/contato#agendar-demonstracao">Agendar demonstração</a>
          <a class="md-wa-link" href="/integracoes">Ver integrações</a>
        </div>
      </div>
      <FolhetoGTF />
    </div>
  </section>

  <PageFoto foto="oficina" alt="Mecânico trabalhando em um motor numa oficina organizada" autor="Artem Podrez" link="https://www.pexels.com/pt-br/foto/homem-pessoa-carro-veiculo-8985703/" titulo="Do escritório à oficina">
    <p>O mesmo sistema que emite o CT-e guarda o histórico de manutenção, a vida de cada pneu e o consumo de combustível. O escritório e o pátio olham para a mesma informação.</p>
    <p>Abaixo, cada módulo com uma explicação curta e uma animação de como funciona.</p>
  </PageFoto>

  {confirmedModules.map((m, idx) => (
    <section id={m.slug} class:list={['md-section', 'md-feature', { 'md-section--soft': idx % 2 === 0, 'md-feature--flip': idx % 2 === 1 }]}>
      <div class="container md-does-grid">
        <div>
          <p class="md-cat"><span class="md-cat__icon"><Icon name={m.slug as IconName} size={20} /></span>{m.category}</p>
          <h2>{m.title}</h2>
          <p class="md-feature__lead">{m.summary}</p>
          <ul class="md-does">
            {m.whatItDoes.map((item, i) => (
              <li>
                <span class="md-does__n">{String(i + 1).padStart(2, '0')}</span>
                <div><h3>{item}</h3>{explicacoes[m.slug]?.[i] && <p>{explicacoes[m.slug][i]}</p>}</div>
              </li>
            ))}
          </ul>
          <a class="md-more" href={`/funcionalidades/${m.slug}`}>Conhecer o módulo {m.title}</a>
        </div>
        <ModuloIlustracao slug={m.slug} title={m.title} />
      </div>
    </section>
  ))}

  <section class="md-section">
    <div class="container">
      <div class="md-help">
        <img src="/images/home/atendente-avatar.webp" alt="" width="160" height="160" loading="lazy" decoding="async" />
        <div>
          <h2>Quer ver os módulos funcionando?</h2>
          <p>Nossa equipe mostra o DataTransp com a rotina da sua transportadora e tira suas dúvidas.</p>
        </div>
        <div class="md-help__actions">
          <a class="btn btn-primary" href="/contato#agendar-demonstracao">Agendar demonstração</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // a barra de módulos fica logo abaixo do menu e marca o módulo que está na tela
  const header = document.querySelector<HTMLElement>('#header');
  const bar = document.querySelector<HTMLElement>('.md-switch--spy');
  const ink = bar?.querySelector<HTMLElement>('.md-switch__ink');
  const links = [...(bar?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [])];
  if (header && bar && ink && links.length) {
    const medir = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    medir();
    addEventListener('resize', medir);

    const marcar = (link: HTMLAnchorElement) => {
      links.forEach((l) => l.classList.toggle('is-here', l === link));
      ink.style.opacity = '1';
      ink.style.transform = `translateX(${link.offsetLeft + 14}px) scaleX(${link.offsetWidth - 28})`;
      // no celular a barra rola de lado: mantém o módulo da vez à vista
      const inner = link.parentElement!;
      if (link.offsetLeft < inner.scrollLeft || link.offsetLeft + link.offsetWidth > inner.scrollLeft + inner.clientWidth) {
        inner.scrollTo({ left: link.offsetLeft - 16, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };

    const porId = new Map(links.map((l) => [l.hash.slice(1), l]));
    const io = new IntersectionObserver((entries) => {
      const visivel = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      const link = visivel && porId.get(visivel.target.id);
      if (link) marcar(link);
    }, { rootMargin: '-35% 0px -55% 0px' });
    porId.forEach((_, id) => { const sec = document.getElementById(id); if (sec) io.observe(sec); });
  }
</script>
