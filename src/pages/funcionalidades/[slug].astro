---
import Layout from '../../layouts/SiteLayout.astro';
import Icon, { type IconName } from '../../components/home/Icon.astro';
import WhatsAppIcon from '../../components/home/WhatsAppIcon.astro';
import { company, modules, integrations } from '../../data/empresa';
import ModuloIlustracao from '../../components/modulos/ModuloIlustracao.astro';
import FolhetoBI from '../../components/modulos/FolhetoBI.astro';
import PageFoto from '../../components/PageFoto.astro';
import { explicacoes } from '../../data/modulos-detalhes';
import { seoModulos } from '../../data/seo';
import { integracoesDetalhes } from '../../data/integracoes-detalhes';
import '../../styles/modulo.css';

export function getStaticPaths() {
  return modules.filter((module) => module.confirmed).map((module) => ({ params: { slug: module.slug } }));
}

const { slug } = Astro.params;
const confirmed = modules.filter((item) => item.confirmed);
const module = confirmed.find((item) => item.slug === slug);
if (!module) {
  throw new Error('Módulo não encontrado');
}
const relatedIntegrations = integrations.filter((item) => module.relatedIntegrations.includes(item.title));
const others = confirmed.filter((item) => item.slug !== slug);
const textos = explicacoes[module.slug] ?? [];
// integrações do mesmo assunto deste módulo (cada uma tem página própria com explicação)
const doAssunto = integrations.filter((i) => integracoesDetalhes[i.slug]?.modulo === module.slug);
const whatsAppUrl = `https://wa.me/55${company.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Olá, quero conhecer o módulo ${module.title} do DataTransp.`)}`;

// foto de banco gratuito (Pexels) só nos módulos em que a imagem mostra o assunto de verdade
const fotos: Record<string, { foto: string; alt: string; autor: string; link: string; titulo: string; texto: string; revelar: 'cortina' | 'circulo' | 'subir' }> = {
  fiscal: {
    foto: 'bau-rodovia', alt: 'Traseira de um caminhão baú em rodovia movimentada', autor: 'Juliana Polizel',
    link: 'https://www.pexels.com/pt-br/foto/caminhao-branco-na-estrada-5668906/', revelar: 'cortina',
    titulo: 'Toda viagem começa num documento',
    texto: 'Antes do caminhão sair, vêm o CT-e e o MDF-e. No DataTransp eles são emitidos no mesmo sistema que cuida do financeiro e da frota.',
  },
  manutencao: {
    foto: 'oficina', alt: 'Mecânico trabalhando em um motor numa oficina organizada', autor: 'Artem Podrez',
    link: 'https://www.pexels.com/pt-br/foto/homem-pessoa-carro-veiculo-8985703/', revelar: 'subir',
    titulo: 'A oficina com o histórico na mão',
    texto: 'Cada revisão fica registrada no veículo certo, sem caderno nem planilha por fora.',
  },
  pneus: {
    foto: 'caminhao-lona', alt: 'Caminhão branco com carreta coberta por lona em uma rodovia', autor: 'TaylorPhotos',
    link: 'https://www.pexels.com/pt-br/foto/caminhao-de-carga-branco-na-estrada-com-ceu-azul-37848366/', revelar: 'subir',
    titulo: 'Cada pneu tem uma história',
    texto: 'O controle de pneus guarda o histórico de toda a frota no sistema, sem planilhas por fora.',
  },
  combustiveis: {
    foto: 'bomba-combustivel', alt: 'Bico de bomba de combustível encaixado no tanque durante o abastecimento', autor: 'Dar ius',
    link: 'https://www.pexels.com/pt-br/foto/bomba-de-gasolina-vermelha-reabastecendo-um-carro-no-posto-28688185/', revelar: 'circulo',
    titulo: 'Cada abastecimento conta',
    texto: 'Consumo de combustível e Arla acompanhado no sistema. Quem tem bomba própria também controla o estoque.',
  },
};
const foto = fotos[module.slug];
const seo = seoModulos[module.slug];
---

<Layout title={seo?.title ?? `${module.title} | DataTransp`} description={seo?.description ?? module.summary} currentPath={`/funcionalidades/${slug}`} bodyClass="page-modulo" breadcrumbs={[{ name: 'Funcionalidades', path: '/funcionalidades' }, { name: module.title, path: `/funcionalidades/${slug}` }]}>
  <!-- troca rápida entre módulos, como as abas de um sistema -->
  <nav class="md-switch" aria-label="Módulos do DataTransp">
    <div class="container md-switch__inner">
      {confirmed.map((m) => (
        <a href={`/funcionalidades/${m.slug}`} aria-current={m.slug === slug ? 'page' : undefined}>
          <Icon name={m.slug as IconName} size={17} />{m.title}
        </a>
      ))}
    </div>
  </nav>

  <section class="md-hero">
    <div class="container md-hero__grid">
      <div>
        <div class="breadcrumbs"><a href="/">Início</a> / <a href="/funcionalidades">Funcionalidades</a> / <span>{module.title}</span></div>
        <p class="md-cat"><span class="md-cat__icon"><Icon name={module.slug as IconName} size={20} /></span>{module.category}</p>
        <h1>{seo?.h1 ?? module.title}</h1>
        <p class="md-lead">{module.summary}</p>
        <div class="md-actions">
          <a class="btn btn-primary" href="/contato#agendar-demonstracao">{module.cta}</a>
          <a class="md-wa" href={whatsAppUrl} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={18} /> Falar no WhatsApp</a>
        </div>
      </div>

      <!-- ficha do módulo: informações objetivas, como um cadastro do sistema -->
      <aside class="md-sheet" aria-label={`Ficha do módulo ${module.title}`}>
        <p class="md-sheet__title">Ficha do módulo</p>
        <dl>
          <div><dt>Módulo</dt><dd>{module.title}</dd></div>
          <div><dt>Categoria</dt><dd>{module.category}</dd></div>
          <div><dt>Para que serve</dt><dd>{module.problem}</dd></div>
          {module.documents.length > 0 && (
            <div><dt>Documentos</dt><dd class="md-chips">{module.documents.map((d) => <span>{d}</span>)}</dd></div>
          )}
          {relatedIntegrations.length > 0 && (
            <div><dt>Integrações</dt><dd class="md-chips">{relatedIntegrations.map((i) => <a href={`/integracoes/${i.slug}`}>{i.title}</a>)}</dd></div>
          )}
        </dl>
      </aside>
    </div>
  </section>

  {foto && (
    <PageFoto foto={foto.foto} alt={foto.alt} autor={foto.autor} link={foto.link} titulo={foto.titulo} revelar={foto.revelar} invertido>
      <p>{foto.texto}</p>
    </PageFoto>
  )}

  <section class="md-section">
    <div class="container">
      <div class="md-does-grid">
        <div>
          <h2>O que o módulo {module.title} faz</h2>
          <ul class="md-does">
            {module.whatItDoes.map((item, i) => (
              <li>
                <span class="md-does__n">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item}</h3>
                  {textos[i] && <p>{textos[i]}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
        <ModuloIlustracao slug={module.slug} title={module.title} />
      </div>

      {module.slug === 'bi' && (
        <FolhetoBI />
      )}
    </div>
  </section>

  {doAssunto.length > 0 && (
    <section class="md-section">
      <div class="container">
        <div class="md-others__head">
          <h2>Integrações ligadas ao módulo {module.title}</h2>
          <a href="/integracoes">Ver todas as integrações</a>
        </div>
        <ul class="md-integ">
          {doAssunto.map((i) => (
            <li>
              <a href={`/integracoes/${i.slug}`}>
                <strong>{i.title}</strong>
                <span>{integracoesDetalhes[i.slug].oQueE}</span>
                <em>Entender esta integração</em>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="md-section md-section--soft">
    <div class="container">
      <div class="md-others__head">
        <h2>Conheça também</h2>
        <a href="/funcionalidades">Ver todas as funcionalidades</a>
      </div>
      <ul class="md-others">
        {others.map((m) => (
          <li>
            <a href={`/funcionalidades/${m.slug}`}>
              <span class="md-others__icon"><Icon name={m.slug as IconName} size={20} /></span>
              <span><strong>{m.title}</strong><small>{m.category}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="md-section">
    <div class="container">
      <div class="md-help">
        <img src="/images/home/atendente-avatar.webp" alt="" width="160" height="160" loading="lazy" decoding="async" />
        <div>
          <h2>Quer ver o módulo {module.title} funcionando?</h2>
          <p>Nossa equipe mostra o módulo com a rotina da sua transportadora e tira suas dúvidas.</p>
        </div>
        <div class="md-help__actions">
          <a class="btn btn-primary" href="/contato#agendar-demonstracao">Agendar demonstração</a>
          <a class="md-wa" href={whatsAppUrl} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={18} /> {company.whatsapp}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // no celular a barra de módulos rola até o módulo aberto, sem mexer na rolagem da página
  const bar = document.querySelector<HTMLElement>('.md-switch__inner');
  const atual = bar?.querySelector<HTMLElement>('[aria-current="page"]');
  if (bar && atual) bar.scrollLeft = atual.offsetLeft - (bar.clientWidth - atual.offsetWidth) / 2;
</script>
