---
import Layout from '../layouts/SiteLayout.astro';
import { company } from '../data/empresa';
import '../styles/modulo.css';
import PageFoto from '../components/PageFoto.astro';

---

<Layout title="Sobre a DataTransp: software para transporte desde 1997" description="A DataTransp desenvolve sistemas para transportadoras e frotistas desde 1997. Fundada em Xaxim/SC, com sede em Chapecó/SC e atendimento em todo o Brasil." currentPath="/empresa" pageType="AboutPage" breadcrumbs={[{ name: 'Empresa', path: '/empresa' }]}>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <div class="breadcrumbs"><a href="/">Início</a> / <span>Empresa</span></div>
      <h1>Experiência em sistemas para transporte desde {company.foundation}</h1>
      <p>{company.history}</p>
    </div>
  </section>

  <PageFoto revelar="subir" foto="rodovia" alt="Caminhão trafegando em rodovia brasileira em dia de céu aberto" autor="Messala Ciulla" link="https://www.pexels.com/pt-br/foto/caminhao-na-estrada-no-brasil-34365732/" titulo="Feito para quem vive a estrada">
    <p>A DataTransp começou em Xaxim, no oeste de Santa Catarina, no meio de transportadoras. O sistema nasceu dessa rotina: nota fiscal, frete, frota e conta para pagar no fim do mês.</p>
    <p>Hoje a sede fica em Chapecó, e o atendimento chega a transportadoras e frotistas de todo o Brasil, pelo WhatsApp e pelo telefone.</p>
  </PageFoto>

  <!-- trajetória: só os marcos confirmados (fundação em Xaxim, sede atual em Chapecó) -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Nossa trajetória</h2>
      <ol class="md-trail" data-trail>
        <li><span class="md-trail__year">{company.foundation}</span><strong>Fundação em Xaxim/SC</strong><p>A DataTransp começa a desenvolver sistemas para transportadoras.</p></li>
        <li><span class="md-trail__year">{company.experienceYears} anos</span><strong>Experiência no transporte</strong><p>Software, implantação com treinamento e suporte para a rotina da transportadora.</p></li>
        <li><span class="md-trail__year">Hoje</span><strong>Sede em Chapecó/SC</strong><p>{company.serviceArea}</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Missão, visão e valores</h2>
      <div class="values-grid">
        <article class="value-card"><h3>Missão</h3><p>{company.mission}</p></article>
        <article class="value-card"><h3>Visão</h3><p>{company.vision}</p></article>
        <article class="value-card value-card-wide">
          <h3>Valores</h3>
          <ul class="list-check">{company.values.map((value) => <li>{value}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">DataTransp Sistemas</h2>
      <dl class="company-facts">
        <div><dt>Razão Social</dt><dd>{company.legalName}</dd></div>
        <div><dt>CNPJ</dt><dd>{company.cnpj}</dd></div>
        <div><dt>Fundação</dt><dd>{company.foundation}, em Xaxim/SC</dd></div>
        <div><dt>Experiência</dt><dd>{company.experienceYears} anos</dd></div>
        <div><dt>Cobertura</dt><dd>{company.serviceArea}</dd></div>
        <div><dt>Sede atual</dt><dd>{company.headquarters}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Canais da DataTransp</h2>
      <div class="contact-grid">
        <a class="contact-card contact-card-link" href={`tel:${company.phone.replace(/[^0-9]/g, '')}`}><h3>Telefone</h3><p>{company.phone}</p></a>
        <a class="contact-card contact-card-link" href={`https://wa.me/55${company.whatsapp.replace(/[^0-9]/g, '')}`}><h3>WhatsApp</h3><p>{company.whatsapp}</p></a>
        <a class="contact-card contact-card-link" href={`mailto:${company.email}`}><h3>E-mail comercial</h3><p>{company.email}</p></a>
      </div>
      <div class="module-cta"><a class="btn btn-primary" href="/contato#agendar-demonstracao">Agendar demonstração</a></div>
    </div>
  </section>
</Layout>

<script>
  // a linha da trajetória cresce junto com a rolagem (CSS, onde o navegador suporta);
  // nos outros, ela se preenche de uma vez quando aparece na tela
  const trail = document.querySelector<HTMLElement>('[data-trail]');
  if (trail && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (CSS.supports('animation-timeline: view()')) trail.classList.add('md-trail--scroll');
    else trail.classList.add('is-ready');
    if (trail.classList.contains('is-ready')) {
      new IntersectionObserver(([e], obs) => { if (e.isIntersecting) { obs.disconnect(); trail.classList.add('is-on'); } }, { threshold: 0.4 }).observe(trail);
    }
  }
</script>
