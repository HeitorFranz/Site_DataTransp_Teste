---
import Layout from '../layouts/SiteLayout.astro';
---

<Layout title="Página não encontrada | Datatransp" description="Página não encontrada" currentPath="/404">
  <section class="section">
    <div class="container">
      <div class="policy-box" style="text-align: center;">
        <h1>Página não encontrada</h1>
        <p>Oops! A página que você tentou acessar não existe ou foi movida.</p>
        <div class="module-cta">
          <a class="btn btn-primary" href="/">Voltar para a home</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
