---
// DATA: assistente virtual do site (respostas prontas em src/scripts/data-bot.ts).
// Sem JS, o botão vira um link direto para o WhatsApp.
import { company } from '../data/empresa';
import DataAvatar from './DataAvatar.astro';
const waHref = `https://wa.me/55${company.whatsapp.replace(/\D/g, '')}`;
---

<div class="databot" data-databot>
  <div class="databot__teaser" data-teaser hidden>
    <button type="button" class="databot__teaser-x" data-teaser-close aria-label="Fechar aviso">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
    </button>
    <button type="button" class="databot__teaser-body" data-teaser-open>
      <strong>Oi! Eu sou o DATA 👋</strong>
      <span>Tire dúvidas sobre o sistema em segundos.</span>
    </button>
  </div>

  <a class="databot__fab" href={waHref} data-fab aria-label="Conversar com o DATA, da DataTransp" aria-expanded="false" aria-controls="databot-panel" role="button">
    <span class="databot__fab-ring" aria-hidden="true"></span>
    <DataAvatar size={52} />
    <span class="databot__badge" data-badge aria-hidden="true">1</span>
  </a>

  <section class="databot__panel" id="databot-panel" role="dialog" aria-modal="false" aria-labelledby="databot-title" hidden data-panel>
    <header class="databot__head">
      <span class="databot__head-av"><DataAvatar size={42} /><i class="databot__online" aria-hidden="true"></i></span>
      <div class="databot__head-txt">
        <h2 id="databot-title">DATA</h2>
        <p data-status>Atendimento DataTransp · on-line</p>
      </div>
      <a class="databot__head-wa" href={waHref} target="_blank" rel="noopener noreferrer" aria-label="Falar com uma pessoa no WhatsApp" title="Falar com uma pessoa">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" /></svg>
      </a>
      <button type="button" class="databot__close" data-close aria-label="Fechar conversa">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
      </button>
    </header>

    <div class="databot__log" role="log" aria-live="polite" aria-label="Conversa com o DATA" data-log data-lenis-prevent>
      <div class="databot__intro">
        <DataAvatar size={64} />
        <strong>DATA, da DataTransp</strong>
        <span>Sistema de gestão para transportadoras desde 1997. Pergunte sobre módulos, preços ou peça sua demonstração.</span>
      </div>
    </div>

    <div class="databot__chips" data-chips></div>

    <form class="databot__form" data-form autocomplete="off">
      <label for="databot-input" class="databot__sr">Escreva sua pergunta</label>
      <input id="databot-input" name="q" type="text" maxlength="300" placeholder="Pergunte sobre preço, módulos, demo..." data-input />
      <button type="submit" aria-label="Enviar" data-send disabled>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6l.1 6.5L15 12 3.5 13.9z" fill="currentColor" /></svg>
      </button>
    </form>
  </section>

  <template data-avatar-tpl><DataAvatar size={28} /></template>
</div>

<style>
  .databot {
    --db-navy: #102746; --db-navy-2: #1d3f6e; --db-red: #e90705; --db-wa: #15803d;
    --db-bg: #f6f8fb; --db-card: #fff; --db-text: #1f3550; --db-soft: #5a6b82; --db-line: #e1e7ef; --db-me: #102746;
    position: fixed; right: 22px; bottom: 22px; z-index: 1100; font-family: inherit;
  }
  @media (prefers-color-scheme: dark) {
    .databot { --db-bg: #0b1730; --db-card: #142645; --db-text: #e6edf7; --db-soft: #9fb0c8; --db-line: #ffffff1a; --db-me: #e90705; }
  }

  /* ---------- botão flutuante ---------- */
  .databot__fab {
    position: relative; display: block; width: 64px; height: 64px; padding: 6px; border-radius: 50%;
    background: #fff; box-shadow: 0 12px 30px #10274659, 0 2px 6px #10274633;
    transition: transform .25s cubic-bezier(.2, .8, .2, 1);
  }
  .databot__fab:hover { transform: translateY(-3px) scale(1.04); }
  .databot__fab-ring { position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--db-red); opacity: 0; }
  .databot__badge {
    position: absolute; top: -2px; right: -2px; display: grid; place-items: center; min-width: 22px; height: 22px; padding: 0 6px;
    border-radius: 999px; background: var(--db-red); color: #fff; font-size: 12px; font-weight: 800; border: 2px solid #fff;
  }
  .databot[data-seen] .databot__badge { display: none; }
  .databot[data-open] .databot__fab, .databot[data-open] .databot__teaser { display: none; }
  .databot :focus-visible { outline: 3px solid #ff6b68; outline-offset: 2px; }

  /* ---------- balão de convite ---------- */
  .databot__teaser { position: absolute; right: 0; bottom: 78px; width: 250px; }
  .databot__teaser[hidden] { display: none; }
  .databot__teaser-body {
    display: grid; gap: 2px; width: 100%; padding: 14px 16px; text-align: left; cursor: pointer;
    background: var(--db-card); color: var(--db-text); border: 1px solid var(--db-line); border-radius: 16px 16px 4px 16px;
    box-shadow: 0 14px 34px #10274633; font: inherit;
  }
  .databot__teaser-body strong { font-size: 15px; }
  .databot__teaser-body span { font-size: 13.5px; color: var(--db-soft); }
  .databot__teaser-x {
    position: absolute; top: -10px; left: -10px; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid var(--db-line); background: var(--db-card); color: var(--db-soft); cursor: pointer; box-shadow: 0 4px 10px #10274626;
  }

  /* ---------- janela ---------- */
  .databot__panel {
    position: absolute; right: 0; bottom: 0; width: 384px; height: min(620px, calc(100dvh - 44px));
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--db-bg); color: var(--db-text); border-radius: 22px;
    box-shadow: 0 30px 70px #10274666, 0 0 0 1px #10274614;
  }
  .databot__panel[hidden] { display: none; }

  .databot__head {
    position: relative; display: flex; align-items: center; gap: 12px; padding: 16px 14px 16px 16px; color: #fff;
    background: radial-gradient(120% 140% at 0% 0%, #2a5592 0%, var(--db-navy) 55%, #0b1d38 100%);
  }
  .databot__head::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, var(--db-red), #ff6b68 60%, transparent); }
  .databot__head-av { position: relative; flex: none; }
  .databot__online { position: absolute; right: 0; bottom: 1px; width: 12px; height: 12px; border-radius: 50%; background: #22c55e; border: 2px solid var(--db-navy); }
  .databot__head-txt { min-width: 0; }
  .databot__head h2 { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: .08em; color: #fff; line-height: 1.1; }
  .databot__head p { margin: 2px 0 0; font-size: 12.5px; color: #c9d6ea; }
  .databot__head-wa, .databot__close {
    display: grid; place-items: center; width: 38px; height: 38px; flex: none; border: 0; border-radius: 50%;
    background: #ffffff1c; color: #fff; cursor: pointer; text-decoration: none; transition: background .2s;
  }
  .databot__head-wa { margin-left: auto; }
  .databot__head-wa:hover { background: var(--db-wa); }
  .databot__close:hover { background: #ffffff33; }

  .databot__log { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 18px 14px 10px; display: flex; flex-direction: column; gap: 6px; scroll-behavior: smooth; }
  .databot__intro { display: grid; justify-items: center; gap: 6px; padding: 6px 18px 14px; text-align: center; }
  .databot__intro strong { font-size: 15px; }
  .databot__intro span { font-size: 12.5px; color: var(--db-soft); line-height: 1.45; }

  /* grupos de mensagens do DATA: avatar ao lado da última bolha */
  .databot__log :global(.db-row) { display: flex; align-items: flex-end; gap: 8px; max-width: 92%; }
  .databot__log :global(.db-row--bot) { align-self: flex-start; }
  .databot__log :global(.db-row--me) { align-self: flex-end; justify-content: flex-end; }
  .databot__log :global(.db-row .data-avatar) { margin-bottom: 2px; }
  .databot__log :global(.db-row--cont .data-avatar) { visibility: hidden; }
  .databot__log :global(.db-msg) {
    margin: 0; padding: 10px 14px; border-radius: 18px; font-size: 14.5px; line-height: 1.45; overflow-wrap: anywhere; white-space: pre-line;
  }
  .databot__log :global(.db-row--bot .db-msg) { background: var(--db-card); color: var(--db-text); border-bottom-left-radius: 6px; box-shadow: 0 1px 2px #1027461a; }
  .databot__log :global(.db-row--me .db-msg) { background: var(--db-me); color: #fff; border-bottom-right-radius: 6px; }
  .databot__log :global(.db-row--me + .db-row--bot), .databot__log :global(.db-row--bot + .db-row--me) { margin-top: 8px; }

  /* botões de ação dentro da conversa */
  .databot__log :global(.db-links) { align-self: flex-start; display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 6px 36px; max-width: calc(92% - 36px); }
  .databot__log :global(.db-link) {
    display: inline-flex; align-items: center; gap: 7px; min-height: 38px; padding: 7px 14px; border-radius: 12px;
    background: var(--db-card); color: var(--db-text); border: 1.5px solid var(--db-line);
    font-size: 13.5px; font-weight: 700; text-decoration: none; transition: border-color .2s, transform .2s;
  }
  .databot__log :global(.db-link:hover) { border-color: var(--db-red); transform: translateY(-1px); }
  .databot__log :global(.db-link svg) { flex: none; }
  .databot__log :global(.db-link--wa) { background: var(--db-wa); border-color: var(--db-wa); color: #fff; }
  .databot__log :global(.db-link--wa:hover) { border-color: #116a32; background: #116a32; }
  .databot__log :global(.db-link--main) { background: var(--db-red); border-color: var(--db-red); color: #fff; }
  .databot__log :global(.db-link--main:hover) { background: #c80705; border-color: #c80705; }
  .databot__log :global(.db-link--ig svg) { color: #d62976; }
  .databot__log :global(.db-link--fb svg) { color: #1877f2; }

  .databot__log :global(.db-typing) { display: flex; gap: 4px; padding: 13px 15px; border-radius: 18px; border-bottom-left-radius: 6px; background: var(--db-card); box-shadow: 0 1px 2px #1027461a; }
  .databot__log :global(.db-typing i) { width: 7px; height: 7px; border-radius: 50%; background: var(--db-soft); opacity: .5; animation: db-dot 1s infinite; }
  .databot__log :global(.db-typing i:nth-child(2)) { animation-delay: .15s; }
  .databot__log :global(.db-typing i:nth-child(3)) { animation-delay: .3s; }

  /* sugestões rápidas */
  .databot__chips { display: flex; gap: 6px; padding: 4px 14px 10px; overflow-x: auto; scrollbar-width: none; }
  .databot__chips::-webkit-scrollbar { display: none; }
  .databot__chips:empty { display: none; }
  .databot__chips :global(button) {
    flex: none; min-height: 36px; padding: 7px 14px; border: 1.5px solid var(--db-red); border-radius: 999px;
    background: transparent; color: var(--db-red); font: inherit; font-size: 13.5px; font-weight: 700; cursor: pointer; white-space: nowrap;
    transition: background .2s, color .2s;
  }
  .databot__chips :global(button:hover) { background: var(--db-red); color: #fff; }
  @media (prefers-color-scheme: dark) { .databot__chips :global(button) { color: #ff8a87; border-color: #ff8a87; } }

  /* campo de texto */
  .databot__form { display: flex; align-items: center; gap: 8px; margin: 0 12px 12px; padding: 6px 6px 6px 16px; border-radius: 999px; background: var(--db-card); box-shadow: 0 0 0 1.5px var(--db-line); transition: box-shadow .2s; }
  .databot__form:focus-within { box-shadow: 0 0 0 2px var(--db-navy-2); }
  .databot__form input { flex: 1; min-width: 0; height: 40px; border: 0; background: none; color: var(--db-text); font: inherit; font-size: 16px; outline: none; }
  .databot__form input::placeholder { color: var(--db-soft); }
  .databot__form button { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border: 0; border-radius: 50%; background: var(--db-red); color: #fff; cursor: pointer; transition: opacity .2s, transform .2s; }
  .databot__form button:disabled { opacity: .35; cursor: default; }
  .databot__form button:not(:disabled):hover { transform: scale(1.06); }
  .databot__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .databot__panel:not([hidden]) { animation: db-open .32s cubic-bezier(.2, .8, .2, 1); transform-origin: bottom right; }
    .databot__log :global(.db-row), .databot__log :global(.db-links) { animation: db-in .32s cubic-bezier(.2, .8, .2, 1) both; }
    .databot__teaser:not([hidden]) { animation: db-pop .45s cubic-bezier(.2, .8, .2, 1.2) both; transform-origin: bottom right; }
    .databot:not([data-seen]) .databot__fab-ring { animation: db-ring 1.4s cubic-bezier(.22,1,.36,1) 1.5s 2; }
  }
  @keyframes db-open { from { opacity: 0; transform: scale(.9) translateY(14px); } }
  @keyframes db-in { from { opacity: 0; transform: translateY(8px); } }
  @keyframes db-pop { from { opacity: 0; transform: scale(.85) translateY(8px); } }
  @keyframes db-dot { 50% { opacity: 1; transform: translateY(-3px); } }
  @keyframes db-ring { 0% { opacity: .7; transform: scale(1); } 100% { opacity: 0; transform: scale(1.35); } }

  @media (max-width: 520px) {
    .databot { right: 14px; bottom: 14px; }
    .databot__fab { width: 58px; height: 58px; padding: 5px; }
    .databot__teaser { bottom: 72px; width: 230px; }
    .databot__panel { position: fixed; inset: 0; width: auto; height: 100dvh; border-radius: 0; }
    .databot__head { padding-top: max(16px, env(safe-area-inset-top)); }
    .databot__form { margin-bottom: max(12px, env(safe-area-inset-bottom)); }
  }
</style>

<script>
  import { responder, saudacaoInicial, type Resposta, type Acao, type Contexto } from '../scripts/data-bot';

  // ícones dos botões de ação, escolhidos pelo destino do link
  const ICONES: Record<string, string> = {
    wa: '<svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>',
    ig: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>',
    fb: '<svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v8h4v-8h3l1-4h-4V8.5c0-.3.2-.5.5-.5Z"/></svg>',
    tel: '<svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1Z"/></svg>',
    mail: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
    map: '<svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>',
    cal: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
    go: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>',
  };
  function tipoLink(href: string): { cls: string; icone: string } {
    if (href.includes('wa.me')) return { cls: 'db-link--wa', icone: ICONES.wa };
    if (href.includes('instagram.com')) return { cls: 'db-link--ig', icone: ICONES.ig };
    if (href.includes('facebook.com')) return { cls: 'db-link--fb', icone: ICONES.fb };
    if (href.startsWith('tel:')) return { cls: '', icone: ICONES.tel };
    if (href.startsWith('mailto:')) return { cls: '', icone: ICONES.mail };
    if (href.includes('google.com/maps')) return { cls: '', icone: ICONES.map };
    if (href.includes('agendar-demonstracao')) return { cls: 'db-link--main', icone: ICONES.cal };
    return { cls: '', icone: ICONES.go };
  }

  const root = document.querySelector<HTMLElement>('[data-databot]');
  if (root) {
    const fab = root.querySelector<HTMLAnchorElement>('[data-fab]')!;
    const panel = root.querySelector<HTMLElement>('[data-panel]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const chips = root.querySelector<HTMLElement>('[data-chips]')!;
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-input]')!;
    const send = root.querySelector<HTMLButtonElement>('[data-send]')!;
    const teaser = root.querySelector<HTMLElement>('[data-teaser]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const avatarTpl = root.querySelector<HTMLTemplateElement>('[data-avatar-tpl]')!;
    const contexto: Contexto = { historico: [] };
    const fila: string[] = [];
    let comecou = false;
    let ocupado = false;
    let ultimo: 'bot' | 'me' | null = null;
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const guardar = (k: string) => { try { sessionStorage.setItem(k, '1'); } catch {} };
    const visto = (k: string) => { try { return sessionStorage.getItem(k) === '1'; } catch { return false; } };
    if (visto('databot-seen')) root.dataset.seen = '';

    const rolar = () => { log.scrollTop = log.scrollHeight; };
    const espera = (ms: number) => new Promise((r) => setTimeout(r, calmo ? 0 : ms));

    function linha(de: 'bot' | 'me', conteudo: HTMLElement) {
      const row = document.createElement('div');
      row.className = `db-row db-row--${de}`;
      if (de === 'bot') {
        // avatar só na primeira bolha de cada sequência do DATA
        if (ultimo === 'bot') row.classList.add('db-row--cont');
        row.append(avatarTpl.content.firstElementChild!.cloneNode(true));
      }
      row.append(conteudo);
      log.append(row);
      ultimo = de;
      rolar();
      return row;
    }

    function bolha(texto: string, de: 'bot' | 'me') {
      const p = document.createElement('p');
      p.className = 'db-msg';
      p.textContent = texto;
      linha(de, p);
    }

    function links(lista: Acao[]) {
      const comLink = lista.filter((a) => a.href);
      if (!comLink.length) return;
      const box = document.createElement('div');
      box.className = 'db-links';
      for (const a of comLink) {
        const el = document.createElement('a');
        const t = tipoLink(a.href!);
        el.href = a.href!;
        el.className = `db-link ${t.cls}`;
        el.innerHTML = t.icone;
        el.firstElementChild?.setAttribute('aria-hidden', 'true');
        el.append(a.label);
        if (/^https?:/.test(a.href!)) { el.target = '_blank'; el.rel = 'noopener noreferrer'; }
        box.append(el);
      }
      log.append(box);
      rolar();
    }

    function sugestoes(lista: Acao[] = []) {
      chips.replaceChildren();
      for (const a of lista.filter((x) => x.reply)) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = a.label;
        b.addEventListener('click', () => enviar(a.reply!));
        chips.append(b);
      }
    }

    async function falar(r: Resposta) {
      ocupado = true;
      sugestoes();
      status.textContent = 'digitando...';
      for (const t of r.textos) {
        const digitando = document.createElement('div');
        digitando.className = 'db-typing';
        digitando.innerHTML = '<i></i><i></i><i></i>';
        const row = linha('bot', digitando);
        // tempo de "digitação" cresce com o tamanho da frase, como uma pessoa
        await espera(Math.min(450 + t.length * 14, 1600));
        row.remove();
        ultimo = log.lastElementChild?.classList.contains('db-row--bot') ? 'bot' : log.lastElementChild?.classList.contains('db-row--me') ? 'me' : null;
        bolha(t, 'bot');
        await espera(160);
      }
      if (r.acoes) { links(r.acoes); sugestoes(r.acoes); }
      ultimo = null;
      status.textContent = 'Atendimento DataTransp · on-line';
      ocupado = false;
      // perguntas feitas enquanto o DATA "digitava" são respondidas em ordem
      const proxima = fila.shift();
      if (proxima) falar(responder(proxima, contexto));
    }

    function enviar(texto: string) {
      const t = texto.trim();
      if (!t) return;
      bolha(t, 'me');
      input.value = '';
      send.disabled = true;
      if (ocupado) fila.push(t);
      else falar(responder(t, contexto));
    }

    function abrir() {
      root!.dataset.open = '';
      root!.dataset.seen = '';
      guardar('databot-seen');
      panel.hidden = false;
      fab.setAttribute('aria-expanded', 'true');
      teaser.hidden = true;
      if (!comecou) { comecou = true; falar(saudacaoInicial()); }
      input.focus();
    }
    function fechar() {
      delete root!.dataset.open;
      panel.hidden = true;
      fab.setAttribute('aria-expanded', 'false');
      fab.focus();
    }

    fab.addEventListener('click', (e) => { e.preventDefault(); abrir(); });
    root.querySelector('[data-close]')!.addEventListener('click', fechar);
    root.querySelector('[data-teaser-open]')!.addEventListener('click', abrir);
    root.querySelector('[data-teaser-close]')!.addEventListener('click', () => { teaser.hidden = true; root.dataset.seen = ''; guardar('databot-seen'); });
    panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') fechar(); });
    input.addEventListener('input', () => { send.disabled = !input.value.trim(); });
    form.addEventListener('submit', (e) => { e.preventDefault(); enviar(input.value); });

    // convite "Oi! Eu sou o DATA" uma vez por visita, depois de alguns segundos
    if (!visto('databot-seen')) setTimeout(() => { if (panel.hidden && !root.hasAttribute('data-seen')) teaser.hidden = false; }, 6000);
  }
</script>
