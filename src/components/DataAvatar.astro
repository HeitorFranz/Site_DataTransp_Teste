---
// Rosto do DATA: robô com visor, nas cores da marca. Os olhos piscam (só com movimento liberado).
interface Props { size?: number; class?: string }
const { size = 40, class: cls } = Astro.props;
// ids únicos: o mesmo avatar aparece várias vezes, às vezes dentro de painel oculto
const id = Math.random().toString(36).slice(2, 8);
---

<svg class:list={['data-avatar', cls]} viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`da-bg-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a5592" />
      <stop offset="1" stop-color="#0b1d38" />
    </linearGradient>
    <linearGradient id={`da-head-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#dfe8f4" />
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="32" fill={`url(#da-bg-${id})`} />
  <!-- antena -->
  <path d="M32 19v-6" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
  <circle class="data-avatar__light" cx="32" cy="11" r="3.6" fill="#e90705" />
  <!-- orelhas -->
  <rect x="10" y="29" width="5" height="11" rx="2.5" fill="#e90705" />
  <rect x="49" y="29" width="5" height="11" rx="2.5" fill="#e90705" />
  <!-- cabeça e visor -->
  <rect x="14" y="19" width="36" height="31" rx="12" fill={`url(#da-head-${id})`} />
  <rect x="19" y="25" width="26" height="15" rx="7.5" fill="#0b1d38" />
  <g class="data-avatar__eyes" fill="#7fd8ff">
    <rect x="24" y="28.5" width="5" height="8" rx="2.5" />
    <rect x="35" y="28.5" width="5" height="8" rx="2.5" />
  </g>
  <path d="M27 44.5q5 3 10 0" stroke="#0b1d38" stroke-width="2.2" fill="none" stroke-linecap="round" />
</svg>

<style>
  .data-avatar { display: block; flex: none; }
  .data-avatar__eyes { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .data-avatar__eyes { animation: da-blink 5s infinite; }
    .data-avatar__light { animation: da-light 5s infinite; }
  }
  @keyframes da-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(.1); } }
  @keyframes da-light { 0%, 92%, 100% { opacity: 1; } 95% { opacity: .4; } }
</style>
