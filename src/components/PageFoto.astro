---
// Foto de banco gratuito (Pexels) com texto ao lado e crédito do fotógrafo.
// Cada página revela a foto de um jeito (prop `revelar`), para não repetir o mesmo efeito no site todo.
// Sem JS ou com movimento reduzido, a foto já aparece pronta.
interface Props {
  foto: string; // nome base em /images/fotos, sem tamanho nem extensão
  alt: string;
  autor: string;
  link: string;
  titulo: string;
  invertido?: boolean;
  /** cortina: faixa lateral · circulo: abre a partir de um canto · subir: de baixo para cima · nenhuma: sem efeito */
  revelar?: 'cortina' | 'circulo' | 'subir' | 'nenhuma';
}
const { foto, alt, autor, link, titulo, invertido = false, revelar = 'cortina' } = Astro.props;
---

<section class:list={['pf', `pf--${revelar}`, { 'pf--inv': invertido }]}>
  <div class="container pf__grid">
    <figure class="pf__fig">
      <div class="pf__media"><img
        src={`/images/fotos/${foto}-800.webp`}
        srcset={`/images/fotos/${foto}-800.webp 800w, /images/fotos/${foto}-1400.webp 1400w`}
        sizes="(max-width: 800px) 100vw, 50vw"
        alt={alt}
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
      /></div>
      <figcaption>Foto: <a href={link} target="_blank" rel="noopener noreferrer">{autor} / Pexels</a></figcaption>
    </figure>
    <div class="pf__text">
      <h2>{titulo}</h2>
      <slot />
    </div>
  </div>
</section>

<style>
  .pf { padding: 3.5rem 0; }
  .pf__grid { display: grid; gap: 2rem; align-items: center; grid-template-columns: 1fr 1fr; }
  .pf--inv .pf__fig { order: 2; }
  .pf__fig { margin: 0; }
  .pf__fig img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; }
  .pf__fig figcaption { margin-top: .5rem; font-size: .8rem; color: var(--ink-soft); }
  .pf__fig figcaption a { color: inherit; }
  .pf__text h2 { margin: 0 0 1rem; color: var(--ink); }
  .pf__text :global(p) { color: var(--ink-soft); margin: 0 0 .75rem; max-width: 52ch; }
  @media (max-width: 800px) {
    .pf__grid { grid-template-columns: 1fr; }
    .pf--inv .pf__fig { order: 0; }
  }
  /* o efeito é uma camada por cima da foto: a imagem fica sempre "visível" para o lazy-load do navegador */
  .pf__media { position: relative; overflow: hidden; border-radius: 14px; }
  @property --pf-r { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.pf-js) .pf:not(.pf--nenhuma) .pf__media::after {
      content: ''; position: absolute; inset: 0; background: var(--brand-navy); pointer-events: none;
    }
    /* cortina (Funcionalidades): faixa sai para o lado */
    :global(.pf-js) .pf--cortina .pf__media::after { transform-origin: right; transition: transform .9s cubic-bezier(.2, .7, .2, 1); }
    :global(.pf-js) .pf--cortina.pf--inv .pf__media::after { transform-origin: left; }
    :global(.pf-js) .pf--cortina.is-on .pf__media::after { transform: scaleX(0); }
    /* círculo (Integrações): a foto abre a partir do canto, como um ponto de conexão;
       a opacidade também cai, então navegador sem @property não fica com a foto coberta */
    :global(.pf-js) .pf--circulo .pf__media::after {
      -webkit-mask: radial-gradient(circle at 18% 82%, transparent var(--pf-r), #000 calc(var(--pf-r) + 1%));
      mask: radial-gradient(circle at 18% 82%, transparent var(--pf-r), #000 calc(var(--pf-r) + 1%));
      transition: --pf-r 1s cubic-bezier(.65, 0, .35, 1), opacity .2s linear .9s;
    }
    :global(.pf-js) .pf--circulo.is-on .pf__media::after { --pf-r: 150%; opacity: 0; }
    /* subir (Empresa): a foto aparece de baixo para cima, como a linha do tempo que cresce */
    :global(.pf-js) .pf--subir .pf__media::after { transform-origin: top; transition: transform .8s cubic-bezier(.22, 1, .36, 1); }
    :global(.pf-js) .pf--subir.is-on .pf__media::after { transform: scaleY(0); }
    :global(.pf-js) .pf--subir .pf__media img { transform: translateY(6%) scale(1.06); transition: transform 1.1s cubic-bezier(.22, 1, .36, 1); }
    :global(.pf-js) .pf--subir.is-on .pf__media img { transform: none; }
  }
</style>

<script>
  document.documentElement.classList.add('pf-js');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-on'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -15% 0px' });
  document.querySelectorAll('.pf').forEach((el) => io.observe(el));
</script>
