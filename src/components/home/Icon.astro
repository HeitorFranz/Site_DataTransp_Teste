---
// Ícone de linha; os desenhos ficam em src/data/icones.ts (também usados pelo menu).
import { iconPaths, type IconName } from '../../data/icones';

export type { IconName };
interface Props { name: IconName; size?: number }
const { name, size = 24 } = Astro.props;
---

<svg class="dt-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={iconPaths[name]} />
