---
import Icon from './Icon.astro';
import { company } from '../../data/empresa';

const points = [
  { icon: 'clock', title: `Desde ${company.foundation}`, text: 'Experiência no setor de transportes.' },
  { icon: 'headset', title: 'Suporte próximo e personalizado', text: 'Equipe de suporte pronta para ouvir, orientar e ajudar você.' },
  { icon: 'shield', title: 'Compromisso com você', text: 'Sua operação e suas necessidades são prioridade.' },
] as const;
---

<section class="dt-join" aria-labelledby="join-title">
  <div class="dt-wrap dt-join__grid">
    <div class="dt-join__intro">
      <h2 id="join-title">Faça parte de quem evolui com a DataTransp</h2>
      <p>Junte-se às transportadoras que estão transformando sua gestão e impulsionando seus resultados.</p>
    </div>

    <div class="dt-person">
      <span class="dt-person__arc" aria-hidden="true"></span>
      <span class="dt-person__disc" aria-hidden="true"></span>
      <img src="/images/home/executivo.webp" alt="Executivo de terno azul-marinho e gravata vermelha, sorrindo" width="900" height="945" loading="lazy" decoding="async" />
    </div>

    <ul class="dt-join__points">
      {points.map((p) => (
        <li>
          <span class="dt-badge"><Icon name={p.icon} /></span>
          <div><h3>{p.title}</h3><p>{p.text}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>
