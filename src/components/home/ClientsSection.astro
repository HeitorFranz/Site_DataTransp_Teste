---
import sharp from 'sharp';
import { depoimentos } from '../../data/depoimentos';

// logos autorizados, na ordem dos depoimentos, com o tamanho real lido no build
const logos = await Promise.all(
  depoimentos
    .flatMap((d) => [d.logo, d.logoExtra].filter((src): src is string => !!src).map((src) => ({ src, empresa: d.empresa })))
    .map(async (l) => {
      const { width = 0, height = 0 } = await sharp(`public${l.src}`).metadata();
      return { ...l, width, height };
    }),
);
---

<section class="dt-clients" aria-labelledby="clients-title">
  <div class="dt-wrap dt-clients__head">
    <h2 id="clients-title">Transportadoras que confiam na DataTransp</h2>
    <a class="dt-clients__link" href="/clientes">Ver depoimentos dos clientes</a>
  </div>

  <!-- faixa infinita: a lista aparece duas vezes para o loop não ter emenda; a cópia fica oculta para leitores de tela -->
  <div class="dt-marquee">
    {[0, 1].map((copy) => (
      <ul class="dt-marquee__track" aria-label={copy ? undefined : 'Clientes DataTransp'} aria-hidden={copy ? 'true' : undefined}>
        {logos.map((l) => (
          <li><img src={l.src} alt={copy ? '' : l.empresa} width={l.width} height={l.height} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    ))}
  </div>
</section>
