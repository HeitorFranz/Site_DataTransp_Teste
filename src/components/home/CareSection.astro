---
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { company } from '../../data/empresa';
import { depoimentos } from '../../data/depoimentos';

const whatsAppUrl = `https://wa.me/55${company.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Olá, quero falar com a equipe Datatransp.')}`;
// depoimento real da pesquisa de satisfação sobre o suporte
const prova = depoimentos.find((d) => d.empresa === 'VS Operador Logístico');
---

<section class="dt-care" aria-labelledby="care-title">
  <div class="dt-wrap dt-care__grid">
    <div class="dt-care__copy">
      <h2 id="care-title">Você não aprende sozinho. E nunca fica sozinho.</h2>
      <p class="dt-care__text">Na implantação, sua equipe aprende a usar cada recurso do sistema. Depois, quando surgir uma dúvida no meio da operação, é só chamar: você fala com gente que conhece a rotina de uma transportadora, pelo WhatsApp ou telefone.</p>

      <ul class="dt-care__points">
        <li>
          <span class="dt-care__icon"><Icon name="graduation" size={20} /></span>
          <div><h3>Treinamento na implantação</h3><p>Sua equipe começa sabendo usar o sistema.</p></div>
        </li>
        <li>
          <span class="dt-care__icon"><WhatsAppIcon size={20} /></span>
          <div><h3>Suporte pelo WhatsApp e telefone</h3><p>Dúvidas e problemas resolvidos com agilidade.</p></div>
        </li>
        <li>
          <span class="dt-care__icon"><Icon name="clock" size={20} /></span>
          <div><h3>Segunda a sexta, 08h às 18h</h3><p>Atendimento direto com a equipe DataTransp.</p></div>
        </li>
      </ul>

      {prova && (
        <figure class="dt-care__proof">
          <blockquote>{prova.texto}</blockquote>
          <figcaption>
            {prova.logo && <img src={prova.logo} alt="" width="480" height="216" loading="lazy" decoding="async" />}
            <span><strong>{prova.nome}</strong>{[prova.cargo, prova.empresa].filter(Boolean).join(', ')}</span>
          </figcaption>
        </figure>
      )}

      <div class="dt-care__actions">
        <a class="dt-btn dt-btn--red" href="/contato#agendar-demonstracao">Agendar demonstração</a>
        <a class="dt-btn dt-btn--wa" href={whatsAppUrl} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={20} /> Falar no WhatsApp</a>
      </div>
    </div>

    <div class="dt-care__media">
      <img src="/images/home/suporte.webp" alt="Atendente de suporte com headset, sorrindo" width="1200" height="800" loading="lazy" decoding="async" />

      <!-- conversa ilustrativa: mostra como é falar com o suporte (não são mensagens reais) -->
      <div class="dt-chat" data-chat aria-label="Exemplo de conversa com o suporte pelo WhatsApp" role="img">
        <div class="dt-chat__head">
          <span class="dt-chat__avatar"><WhatsAppIcon size={16} /></span>
          <span><strong>Suporte DataTransp</strong><small>WhatsApp</small></span>
        </div>
        <p class="dt-chat__msg dt-chat__msg--in">Bom dia! Fiquei com dúvida para encerrar um MDF-e.</p>
        <p class="dt-chat__typing" aria-hidden="true"><i></i><i></i><i></i></p>
        <p class="dt-chat__msg dt-chat__msg--out">Bom dia! Te mostro agora, passo a passo.</p>
        <p class="dt-chat__msg dt-chat__msg--in">Pronto, deu certo. Obrigado!</p>
        <small class="dt-chat__note">Exemplo de atendimento</small>
      </div>
    </div>
  </div>
</section>

<script>
  // a conversa aparece mensagem por mensagem quando a seção entra na tela (uma vez só)
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  if (chat && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    chat.classList.add('is-waiting');
    new IntersectionObserver((entries, obs) => {
      if (!entries[0].isIntersecting) return;
      obs.disconnect();
      chat.classList.remove('is-waiting');
      chat.classList.add('is-playing');
    }, { threshold: 0.4 }).observe(chat);
  }
</script>
