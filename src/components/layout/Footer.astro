---
import Brand from '../Brand.astro';
import WhatsAppIcon from '../home/WhatsAppIcon.astro';
import { company } from '../../data/empresa';
import './footer.css';

const tel = `tel:+55${company.phone.replace(/\D/g, '')}`;
const whatsAppUrl = `https://wa.me/55${company.whatsapp.replace(/\D/g, '')}`;
---

<footer class="sf">
  <div class="container">
    <!-- marca e chamada principal -->
    <div class="sf-top">
      <div class="sf-brand">
        <Brand footer />
        <p>Software de gestão para transportadoras e frotistas.</p>
        <address>{company.headquarters}</address>
      </div>
      <div class="sf-cta">
        <a class="btn btn-primary" href="/contato#agendar-demonstracao">Agendar demonstração</a>
        <a class="sf-wa" href={whatsAppUrl} target="_blank" rel="noopener noreferrer"><WhatsAppIcon size={18} /> {company.whatsapp}</a>
      </div>
    </div>

    <div class="sf-cols">
      <nav aria-label="Sistema">
        <h2>Sistema</h2>
        <ul>
          <li><a href="/funcionalidades">Funcionalidades</a></li>
          <li><a href="/integracoes">Integrações</a></li>
          <li><a href="/novidades">Novidades</a></li>
        </ul>
      </nav>
      <nav aria-label="Empresa">
        <h2>Empresa</h2>
        <ul>
          <li><a href="/empresa">Sobre a DataTransp</a></li>
          <li><a href="/clientes">Clientes</a></li>
          <li><a href="/contato">Contato</a></li>
        </ul>
      </nav>
      <div>
        <h2>Atendimento</h2>
        <ul>
          <li class="sf-hours">Segunda a sexta, 08h às 18h</li>
          <li><a href={tel}>{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="sf-bottom">
      <p>© {new Date().getFullYear()} {company.legalName} <span>CNPJ {company.cnpj}</span></p>
      <ul>
        <li><a href="/politica-de-privacidade">Privacidade</a></li>
        <li><a href="/politica-de-cookies">Cookies</a></li>
        <li><a href="/termos-de-uso">Termos de uso</a></li>
        <li><a href="/novidades/feed.xml">RSS</a></li>
        {company.facebook && <li><a href={company.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>}
        {company.instagram && <li><a href={company.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>}
      </ul>
    </div>
  </div>
</footer>
