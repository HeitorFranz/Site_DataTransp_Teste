---
import Brand from '../Brand.astro';
import SiteNav from './SiteNav';
import { company, modules, navigation } from '../../data/empresa';
const { currentPath = '/' } = Astro.props;
const modulos = modules.filter((m) => m.confirmed).map(({ slug, title, summary }) => ({ slug, title, summary }));
---

<header class="header" id="header">
  <div class="container nav-container">
    <Brand />

    <!-- computador: menu animado com painéis -->
    <div class="nav-desktop">
      <SiteNav client:load currentPath={currentPath} modules={modulos} facebook={company.facebook || undefined} whatsapp={company.whatsapp} phone={company.phone} />
    </div>
    <a href="/contato#agendar-demonstracao" class="btn btn-orange nav-btn nav-desktop-cta">Agendar demonstração</a>

    <!-- celular e tablet: menu sanduíche -->
    <button
      class="menu-toggle"
      id="menuToggle"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Abrir menu principal"
      type="button"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="nav-mobile" aria-label="Navegação principal">
      <ul class="nav-menu" id="navMenu">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class:list={['nav-link', { 'is-active': currentPath === item.href }]} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href="/contato#agendar-demonstracao" class="btn btn-orange nav-btn">
            Agendar demonstração
          </a>
        </li>
        {company.instagram || company.facebook ? (
          <li class="nav-socials" aria-label="Redes sociais">
          {company.instagram && <a href={company.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram da DataTransp">Instagram</a>}
          {company.facebook && <a href={company.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook da DataTransp">Facebook</a>}
          </li>
        ) : null}
      </ul>
    </nav>
  </div>
</header>
